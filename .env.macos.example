# LegalRAG Pro macOS environment template
#
# Do NOT commit secrets. The normal runtime continues to read the repository
# .env file. Transfer your existing LegalRAG .env to the Mac securely or recreate it.
#
# macOS deployment scripts automatically provide:
#   LOCALAPPDATA="$HOME/Library/Application Support"
#   LEGALRAG_POPPLER_PATH="$(brew --prefix poppler)/bin"
#   PYTHONPATH="<repo>:<repo>/src"
#
# Optional examples:
#
# OPENAI_API_KEY=
# LEGALRAG_INTERACTIVE_CHAT_MODEL=
# LEGALRAG_INTERACTIVE_REASONING_EFFORT=
# LEGALRAG_SOLICITOR_TASK_ROOT=
# LEGALRAG_WORK_PRODUCT_RELEASE_ROOT=
# LEGALRAG_LEGAL_AUTHORITY_VERIFICATION_ROOT=
