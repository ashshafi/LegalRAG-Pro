# Copy this file to .env only in the deployment environment.
# Never commit the real .env file or any secret value.

OPENAI_API_KEY=replace-with-your-secret

# Absolute host path containing the persistent LegalRAG data directories:
# db/
# data/
# docs/
# source_evidence_store/
# report_projections/
# governed_analytical_authorities/
#
# Linux VPS example:
LEGALRAG_DATA_ROOT=/srv/legalrag

# Private-access authentication
# Comma-separated explicit allowlist. Replace with real authorised identity email(s).
LEGALRAG_ALLOWED_EMAILS=you@example.com
# Optional named Streamlit OIDC provider. Leave blank for the default [auth] provider.
LEGALRAG_OIDC_PROVIDER=
# External directory containing secrets.toml; do not place real secrets in the repository.
LEGALRAG_STREAMLIT_SECRETS_DIR=/opt/legalrag/secrets/.streamlit
